[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[master_nodes]
master-open5gs ansible_ssh_host=192.168.57.5 ansible_ssh_port=22 ansible_user=vagrant ansible_ssh_private_key_file=.vagrant/machines/master-open5gs-277/libvirt/private_key node_ip=192.168.57.5

[worker_nodes]
worker-open5gs-01 ansible_ssh_host=192.168.57.6 ansible_ssh_port=22 ansible_user=vagrant ansible_ssh_private_key_file=.vagrant/machines/worker-open5gs-277-01/libvirt/private_key node_ip=192.168.57.6
worker-open5gs-02 ansible_ssh_host=192.168.57.7 ansible_ssh_port=22 ansible_user=vagrant ansible_ssh_private_key_file=.vagrant/machines/worker-open5gs-277-02/libvirt/private_key node_ip=192.168.57.7
